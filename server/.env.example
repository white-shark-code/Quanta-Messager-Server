# Type database
DB_TYPE = "postgresql" # "sqlite" "mysql" "mariadb"

# Connection string
DB_PATH = "user:password@localhost:5432/dbname"
# Example for sqlite
# DB_PATH = "/./test.db"
# Example for MySQL/MariaDB
# DB_PATH = "user:password@localhost:3306/dbname"
# PostgreSQL (example for asyncpg driver)

# Secret key need for generation password and restore code
SECRET_KEY_VER = '1234'
SECRET_KEY_REST = '1234'

# Maximum media file size in bytes (default: 50 MB)
MAX_MEDIA_SIZE_BYTES=52428800

# Storage backend for media: "database" or "s3"
MEDIA_STORAGE_TYPE=database

# Redis event bus for WebSocket notifications (no password in repo)
REDIS_URL=redis://192.168.1.50:6381/0

# Web Push (VAPID) — generate locally, never commit real keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=
